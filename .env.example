# Copie este arquivo para ".env" e preencha com os dados do seu projeto Supabase
# (Painel do Supabase > Project Settings > API)

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# E-mail interno usado para o login único da equipe (não aparece na tela).
# Precisa ser exatamente o mesmo e-mail do usuário criado no Supabase Auth (ver supabase/SETUP.md)
VITE_APP_LOGIN_EMAIL=equipe@solsolucoes.app
